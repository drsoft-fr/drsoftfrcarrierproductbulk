<form id="product-filters"
      hx-get="{{ path('admin_drsoft_fr_carrier_product_bulk_product_list') }}"
      hx-target="#products-list"
      hx-swap="innerHTML"
      class="mb-3 p-3 border">
    <h4>
        <a class="btn btn-link" data-toggle="collapse" href="#product-filters-collapse" role="button"
           aria-expanded="false" aria-controls="product-filters-collapse">
            {{ 'Product filters'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}
        </a>
    </h4>
    <div id="product-filters-collapse" class="collapse">
        <div class="row mb-2">
            <div class="col-md-2 mt-2">
                <label class="form-control-label"
                       for="product-filters__product-id">{{ 'ID Product'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <input id="product-filters__product-id" type="number" name="idProduct" class="form-control"
                       placeholder="{{ 'ID Product'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}">
            </div>
            <div class="col-md-2 mt-2">
                <label class="form-control-label"
                       for="product-filters__name">{{ 'Name'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <input id="product-filters__name" type="text" name="name" class="form-control"
                       placeholder="{{ 'Name'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}">
            </div>
            <div class="col-md-2 mt-2">
                <label class="form-control-label"
                       for="product-filters__reference">{{ 'Reference'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <input id="product-filters__reference" type="text" name="reference" class="form-control"
                       placeholder="{{ 'Reference'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}">
            </div>
            <div class="col-md-2 mt-2">
                <label class="form-control-label"
                       for="product-filters__supplier-reference">{{ 'Supplier Ref.'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <input id="product-filters__supplier-reference" type="text" name="supplierReference"
                       class="form-control"
                       placeholder="{{ 'Supplier Ref.'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}">
            </div>
            <div class="col-md-2 mt-2">
                <label class="form-control-label"
                       for="product-filters__weight-min">{{ 'Min. weight'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <input id="product-filters__weight-min" type="number" name="weightMin" step="0.01" class="form-control"
                       placeholder="{{ 'Min. weight'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}">
            </div>
            <div class="col-md-2 mt-2">
                <label class="form-control-label"
                       for="product-filters__weight-max">{{ 'Max. weight'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <input id="product-filters__weight-max" type="number" name="weightMax" step="0.01" class="form-control"
                       placeholder="{{ 'Max. weight'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}">
            </div>
            <div class="col-md-2 mt-2">
                <label for="product-filters__id-category-default"
                       class="form-control-label">{{ 'Default category'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <select id="product-filters__id-category-default" name="idCategoryDefault[]" class="form-control"
                        multiple
                        aria-multiselectable="true">
                    <option value="">{{ 'No category selected'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}">{{ category.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2 mt-2">
                <label for="product-filters__id-category"
                       class="form-control-label">{{ 'Linked category'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <select id="product-filters__id-category" name="idCategory[]" class="form-control" multiple
                        aria-multiselectable="true">
                    <option value="">{{ 'No category selected'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}">{{ category.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2 mt-2">
                <label for="product-filters__supplier"
                       class="form-control-label">{{ 'Supplier'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <select id="product-filters__supplier" name="idSupplier[]" class="form-control" multiple
                        aria-multiselectable="true">
                    <option value="">{{ 'No supplier selected'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</option>
                    {% for supplier in suppliers %}
                        <option value="{{ supplier.id }}">{{ supplier.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2 mt-2">
                <label for="product-filters__manufacturer"
                       class="form-control-label">{{ 'Manufacturer'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <select id="product-filters__manufacturer" name="idManufacturer[]" class="form-control" multiple
                        aria-multiselectable="true">
                    <option value="">{{ 'No manufacturer selected'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</option>
                    {% for manufacturer in manufacturers %}
                        <option value="{{ manufacturer.id }}">{{ manufacturer.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2 mt-2">
                <label for="product-filters__active"
                       class="form-control-label">{{ 'Active'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <select id="product-filters__active" name="active" class="form-control">
                    <option value="">--</option>
                    <option value="1">{{ 'Yes'|trans({}, 'Admin.Global') }}</option>
                    <option value="0">{{ 'No'|trans({}, 'Admin.Global') }}</option>
                </select>
            </div>
        </div>
        <hr class="m-3 mt-4">
        <div>
            <h5>{{ 'Carrier filters'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</h5>
        </div>
        <div class="row mb-2">
            <div class="col-md-6 mt-2">
                <label for="product-filters__id-carrier"
                       class="form-control-label">{{ 'Carrier(s)'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <select id="product-filters__id-carrier" name="idCarrier[]" class="form-control" multiple
                        aria-multiselectable="true">
                    <option value="">{{ 'No carrier selected'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</option>
                    {% for carrier in carriers %}
                        <option value="{{ carrier.id_reference }}">
                            #{{ carrier.id_reference }} - {{ carrier.name }} -

                            {% if carrier.is_free %}
                                <span class="badge badge-success">{{ 'Free'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</span>
                            {% else %}
                                <span class="badge badge-danger">{{ 'Not free'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</span>
                            {% endif %} -

                            {% if carrier.active %}
                                <span class="badge badge-success">{{ 'Active'|trans({}, 'Admin.Global') }}</span>
                            {% else %}
                                <span class="badge badge-danger">{{ 'Inactive'|trans({}, 'Admin.Global') }}</span>
                            {% endif %} -

                            {% if carrier.deleted %}
                                <span class="badge badge-danger">{{ 'Deleted'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</span>
                            {% else %}
                                <span class="badge badge-success">{{ 'Not deleted'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</span>
                            {% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-6 mt-2">
                <label for="product-filters__carrier-association"
                       class="form-control-label">{{ 'Carrier association'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</label>
                <select id="product-filters__carrier-association" name="carrierAssociation" class="form-control">
                    <option value="">--</option>
                    <option value="with">{{ 'Associated'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</option>
                    <option value="without">{{ 'Not associated'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Admin') }}</option>
                </select>
            </div>
        </div>
        <div class="mt-3 row">
            <div class="col-12 col-md-6">
                <button type="submit"
                        class="btn btn-primary w-100">{{ 'Search Products'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Actions') }}</button>
            </div>
            <div class="col-12 col-md-6 mt-3 mt-md-0">
                <button type="button"
                        class="btn btn-default w-100"
                        @click="
      $el.closest('form').reset();
      $el.closest('form').dispatchEvent(new Event('submit', { bubbles: true }))
    ">
                    {{ 'Reset'|trans({}, 'Modules.Drsoftfrcarrierproductbulk.Actions') }}
                </button>
            </div>
        </div>
    </div>
    <input type="hidden" name="page" value="{{ product_current_page|default(1) }}">
    <input type="hidden" name="limit" value="{{ product_limit|default(20) }}">
</form>
