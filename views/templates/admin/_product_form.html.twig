<form
        id="product-filters"
        hx-get="{{ path('admin_drsoft_fr_carrier_product_bulk_product_list') }}"
        hx-target="#products-list"
        hx-swap="innerHTML"
        class="mb-3 p-3 border"
>
    <h4>Filtres Produits</h4>
    <div class="row mb-2">
        <div class="col-md-2"><input type="number" name="idProduct" class="form-control" placeholder="ID Produit"></div>
        <div class="col-md-2"><input type="text" name="name" class="form-control" placeholder="Nom"></div>
        <div class="col-md-2"><input type="text" name="reference" class="form-control" placeholder="Référence"></div>
        <div class="col-md-2"><input type="text" name="supplierReference" class="form-control" placeholder="Réf Fournisseur"></div>
        <div class="col-md-2"><input type="number" name="weightMin" step="0.01" class="form-control" placeholder="Poids Min"></div>
        <div class="col-md-2"><input type="number" name="weightMax" step="0.01" class="form-control" placeholder="Poids Max"></div>
    </div>
    <!-- Catégories, Fournisseurs etc -->
    <div class="row mb-2">
        <div class="col-md-2">
            <label for="product__id-category-default" class="form-control-label">Catégorie par défaut</label>
            <select id="product__id-category-default" name="idCategoryDefault[]" class="form-control" multiple aria-multiselectable="true">
                <option value="">Aucune catégorie sélectionnée</option>
                {% for category in categories %}
                    <option value="{{ category.id_category }}">{{ category.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <label for="product__id-category" class="form-control-label">Catégorie liée</label>
            <select id="product__id-category" name="idCategory[]" class="form-control" multiple aria-multiselectable="true">
                <option value="">Aucune catégorie sélectionnée</option>
                {% for category in categories %}
                    <option value="{{ category.id_category }}">{{ category.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <label for="product__supplier" class="form-control-label">Fournisseur</label>
            <select id="product__supplier" name="idSupplier[]" class="form-control" multiple aria-multiselectable="true">
                <option value="">Aucun fournisseur sélectionné</option>
                {% for supplier in suppliers %}
                    <option value="{{ supplier.supplier_id }}">{{ supplier.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <label for="product__manufacturer" class="form-control-label">Fabricant</label>
            <select id="product__manufacturer" name="idManufacturer[]" class="form-control" multiple aria-multiselectable="true">
                <option value="">Aucun fabricant sélectionné</option>
                {% for manufacturer in manufacturers %}
                    <option value="{{ manufacturer.manufacturer_id }}">{{ manufacturer.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <select name="active" class="form-control">
                <option value="">Actif</option>
                <option value="1">Oui</option>
                <option value="0">Non</option>
            </select>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Rechercher Produits</button>
    <button type="button"
            class="btn btn-default"
            @click="
      $el.closest('form').reset();
      $el.closest('form').dispatchEvent(new Event('submit', { bubbles: true }))
    ">
        Réinitialiser
    </button>
</form>
