{% extends '@Modules/drsoftfrcarrierproductbulk/views/templates/admin/base.html.twig' %}

{% block content %}
    <div
            x-data="carrierProductBulk"
            x-init="initSelections()"
            class="carrier-product-bulk-wrapper"
    >
        <h1>Carrier Product Bulk</h1>

        <!-- Notifications -->
        <template x-if="message">
            <div class="alert alert-success" x-text="message" x-show="message" x-transition></div>
        </template>

        <!-- Résumé sélection -->
        <div class="mb-4 p-2 bg-light border">
            <strong>Transporteurs :</strong> <span x-text="selectedCarriers.length"></span> sélectionné(s) |
            <strong>Produits :</strong> <span x-text="selectedProducts.length"></span> sélectionné(s)
        </div>

        <!-- Form Filtres + Liste Transporteurs -->
        {% include '@Modules/drsoftfrcarrierproductbulk/views/templates/admin/_carrier_form.html.twig' %}
        <div id="carriers-list">
            {% include '@Modules/drsoftfrcarrierproductbulk/views/templates/admin/_carrier_list.html.twig' %}
        </div>

        <!-- Form Filtres + Liste Produits -->
        {% include '@Modules/drsoftfrcarrierproductbulk/views/templates/admin/_product_form.html.twig' %}
        <div id="products-list">
            {% include '@Modules/drsoftfrcarrierproductbulk/views/templates/admin/_product_list.html.twig' %}
        </div>

        <!-- Actions Bulk -->
        <div class="mt-4">
            <button @click="submitAction('add')" class="btn btn-success">
                ✅ Ajouter les transporteurs aux produits
            </button>
            <button @click="submitAction('remove')" class="btn btn-danger">
                ❌ Retirer les transporteurs des produits
            </button>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.6/dist/htmx.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

    <!-- AlpineJS logique -->
    <script>
      document.addEventListener('alpine:init', () => {
        Alpine.data('carrierProductBulk', () => ({
          selectedCarriers: [],
          selectedProducts: [],
          message: '',

          initSelections() {
            this.syncSelections('carriers')
            this.syncSelections('products')
          },

          toggleItem(type, event) {
            const id = parseInt(event.target.value)
            let array = type === 'carriers' ? this.selectedCarriers : this.selectedProducts
            if (event.target.checked) {
              if (!array.includes(id)) array.push(id)
            } else {
              array = array.filter(i => i !== id)
            }
            if (type === 'carriers') this.selectedCarriers = array
            else this.selectedProducts = array
          },

          toggleAll(type, event) {
            const checkboxes = document.querySelectorAll(`#${type}-list input[type="checkbox"].bulk-item`)
            let array = []
            if (event.target.checked) {
              checkboxes.forEach(cb => {
                cb.checked = true
                array.push(parseInt(cb.value))
              })
            } else {
              checkboxes.forEach(cb => cb.checked = false)
            }
            if (type === 'carriers') this.selectedCarriers = array
            else this.selectedProducts = array
          },

          syncSelections(type) {
            let array = type === 'carriers' ? this.selectedCarriers : this.selectedProducts
            const checkboxes = document.querySelectorAll(`#${type}-list input[type="checkbox"].bulk-item`)
            checkboxes.forEach(cb => {
              cb.checked = array.includes(parseInt(cb.value))
            })
          },

          submitAction(action) {
            if (this.selectedCarriers.length === 0 || this.selectedProducts.length === 0) {
              this.message = 'Sélection incomplète.'
              return
            }
            fetch('{{ path('admin_drsoft_fr_carrier_product_bulk_ajax') }}', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: action,
                carriers: this.selectedCarriers,
                products: this.selectedProducts
              })
            })
              .then(r => r.json())
              .then(data => {
                this.message = data.message
                setTimeout(() => this.message = '', 4000)
              })
          }
        }))
      })
    </script>
{% endblock %}
